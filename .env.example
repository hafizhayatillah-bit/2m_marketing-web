
# Supabase Session Pooler (Supavisor) — WAJIB, jangan pakai direct connection
# (db.<project-ref>.supabase.co) karena itu IPv6-only dan tidak bisa diakses
# dari platform hosting gratis (Render/Koyeb) yang cuma punya egress IPv4.
# Ambil dari Supabase Dashboard -> Connect -> mode "Session" (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
